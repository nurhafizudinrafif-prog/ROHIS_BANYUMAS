{
  "redirects": [
    {
      "source": "/tentang",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tentang/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/(google[a-zA-Z0-9_-]+\\.html)",
      "destination": "/$1"
    },
    {
      "source": "/((?!api|robots\\.txt|sitemap\\.xml|google[a-zA-Z0-9_-]+\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
