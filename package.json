{
  "name": "wbr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix public-app run dev",
    "dev:admin": "npm --prefix admin run dev",
    "build": "npm --prefix public-app install && npm --prefix public-app run build && node -e \"const fs=require('fs'); fs.cpSync('public-app/dist', 'dist', {recursive: true});\"",
    "build:admin": "npm --prefix admin install && npm --prefix admin run build",
    "preview": "npm --prefix public-app run preview"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.11.0",
    "vite": "^8.2.2"
  }
}
